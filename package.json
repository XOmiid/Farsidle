{
  "name": "farsidle",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "db:prepare": "node scripts/prepare-database.mjs",
    "format": "prettier --write app components lib scripts tests README.md package.json next.config.mjs eslint.config.mjs",
    "format:check": "prettier --check app components lib scripts tests README.md package.json next.config.mjs eslint.config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.5",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10"
  }
}
